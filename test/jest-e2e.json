{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "maxWorkers": 1,
  "setupFiles": ["<rootDir>/support/e2e-env.ts"],
  "transformIgnorePatterns": [
    "node_modules/(?!(otplib|@otplib|@scure|@noble)/)"
  ]
}