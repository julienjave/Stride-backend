api.stridecare.app {
	# Caddy's flagship feature — genuinely this simple. Because the site
	# address above is a real domain (not an IP or "localhost"), Caddy
	# automatically requests and renews a real Let's Encrypt certificate for
	# it, and automatically redirects any plain HTTP request to HTTPS. No
	# separate TLS config block, no manual redirect rule — both are Caddy's
	# defaults the moment it sees a real domain name here.
	#
	# "app" is the OTHER container's service name from docker-compose.prod.yml
	# — resolved via Docker's internal DNS, not a real hostname on the public
	# internet. 3000 matches main.ts's app.listen(process.env.PORT ?? 3000).
	# WebSocket upgrade requests (Socket.IO's handshake) are proxied
	# automatically too — reverse_proxy detects and handles the Connection:
	# Upgrade header without any extra configuration.
	reverse_proxy app:3000

	# A separate, proxy-level log from the application's own pino output —
	# this captures every request Caddy receives, INCLUDING ones that never
	# reach the app at all (e.g. a 502 if the app container is down), which
	# pino's own logs would have no record of, since the app never saw them.
	# Logged to stdout deliberately, not a file — Docker's own logging
	# driver captures and persists that automatically, the same way
	# `docker logs stride-app` already works for the app container. A file
	# path here would need its own separate volume mount to survive a
	# restart at all; stdout needs nothing extra.
	log {
		output stdout
		format json
	}
}

files.stridecare.app {
	# Storage's PUBLIC address: where browsers download photos, through the
	# presigned URLs the API signs for exactly this host (STORAGE_PUBLIC_URL —
	# src/config/storage-urls.ts says why it must be a host of its own). The
	# same RustFS container as always; this site only gives browsers a way in.
	#
	# Only signed DOWNLOADS pass: a GET inside the `stride` bucket — the only
	# kind of URL the API signs (the method is part of the signature, so even
	# a HEAD on one of them is refused by RustFS). Uploads, deletes and
	# listings are the backend's alone, made on the internal address
	# (storage:9000), so the rest of the S3 API isn't reachable from the
	# internet at all. RustFS still checks each request's signature — this
	# only shrinks what a stranger can even try.
	@download {
		method GET
		path /stride/*
	}
	handle @download {
		# Caddy forwards the original Host header (files.stridecare.app) by
		# default. RustFS needs exactly that: it recomputes the URL's signature
		# from the host the browser asked for, and a different one would fail.
		reverse_proxy storage:9000

		# "?" = only when the answer doesn't say already. The library's covers
		# come with their own (`private, max-age=3600`, part of their signed
		# URL); every other photo would come with none — and Cloudflare caches
		# .jpg/.png answers at its edge by default. `private` tells it not to:
		# a patient's photo is kept by their own browser, never by a shared cache.
		header ?Cache-Control "private"
	}
	handle {
		respond 404
	}

	log {
		output stdout
		format json
	}
}
