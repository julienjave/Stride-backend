{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "types": [
      "babel__core",
      "babel__generator",
      "babel__template",
      "babel__traverse",
      "bcrypt",
      "body-parser",
      "connect",
      "cookiejar",
      "cors",
      "eslint",
      "eslint-scope",
      "estree",
      "express",
      "express-serve-static-core",
      "express-session",
      "http-errors",
      "istanbul-lib-coverage",
      "istanbul-lib-report",
      "istanbul-reports",
      "jest",
      "json-schema",
      "methods",
      "multer",
      "node",
      "passport",
      "passport-local",
      "passport-strategy",
      "pg",
      "qrcode",
      "qs",
      "range-parser",
      "send",
      "serve-static",
      "stack-utils",
      "superagent",
      "supertest",
      "validator",
      "ws",
      "yargs",
      "yargs-parser"
    ]
  },
  "ts-node": {
    "files": true
  }
}