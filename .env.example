# === Database ===
# HOST/PORT are container SERVICE NAMES in production mode, not "localhost".
# app and db will be both containers on the same docker-compose network, 
# unlike local dev where the app runs directly on your host machine 
# and reaches the db container through its published port on localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres # In production mode, generate: openssl rand -hex 24
POSTGRES_DB=stride

# Restricted, non-superuser role the app's own runtime queries connect as
# (everything through drizzle.provider.ts) — separate from POSTGRES_USER
# above, which stays the superuser/owner used only for migrations and setup
# scripts. Must NOT be left as any placeholder — validateEnv() refuses to
# boot without a real value here. Run `npm run db:create-app-role` first to
# create/sync this role in Postgres, matching whatever you set below.
POSTGRES_APP_USER=stride_app
POSTGRES_APP_PASSWORD=replace-with-a-long-random-string # Generate: openssl rand -hex 24

# === Storage (RustFS) ===
# Same reasoning as POSTGRES_HOST above — the service name in production, not localhost.
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
# Where BROWSERS reach storage: the address photo links are signed for.
# Leave it unset locally (links then use localhost:9000, as above). REQUIRED
# in production, where storage:9000 means nothing to a browser: the https://
# site the Caddyfile forwards to storage — validateEnv() refuses to boot
# without it. (src/config/storage-urls.ts explains why it's a host of its own.)
# STORAGE_PUBLIC_URL=https://files.stridecare.app
# The access key: 16 characters (-hex 8). A 32-character key broke the RustFS
# console's sign-in on the first deployment (docs/DEPLOYMENT.md, Phase 3).
RUSTFS_ACCESS_KEY=rustfsadmin # In production mode, generate: openssl rand -hex 8
RUSTFS_SECRET_KEY=rustfsadmin # In production mode, generate: openssl rand -hex 24

# === Sessions ===
# Must NOT be left as any placeholder — validateEnv() refuses to boot
# without a real value here.
SESSION_SECRET=replace-with-a-long-random-string # Generate: openssl rand -hex 32

# === CORS / Frontend ===
# FRONTEND_URL (singular) — used to build the actual link inside password
# reset emails. One canonical URL.
FRONTEND_URL=http://localhost:5173
# FRONTEND_URLS (plural) — comma-separated list of every origin allowed to
# make credentialed requests to this API. Add a second, comma-separated
# entry here later if you ever stand up a staging frontend too.
FRONTEND_URLS=http://localhost:5173

# === Proxy trust ===
# Number of reverse proxy hops in front of this app to trust for determining
# the real client IP (used by rate limiting, audit logging). Leave unset
# locally (defaults to 1, effectively harmless with no proxy present).
# Production behind Cloudflare + Caddy: set to 2.
# TRUST_PROXY_HOPS=2

# === Node environment ===
# When in production mode
# Flips pino to raw JSON logging, and makes the session cookie Secure (it is
# SameSite=Lax everywhere — src/config/session-cookie.ts) — both REQUIRE
# this to be exactly "production", not left unset.
# NODE_ENV=production

# === Rate limits ===
# The throttler: 60 requests a minute per route and IP, 5 for the login and
# password routes. "on" (the default — leave it unset) or "off". "off" is
# for the e2e tests only (test/support/e2e-env.ts sets it) and is REFUSED
# when NODE_ENV=production: it would disable the protection against
# password guessing.
# RATE_LIMITS=on

# === Demo Mode ===
# Demo mode — the deployment reviewers use. OFF by default:
# a real clinic's deployment must leave it unset. When 'on', the sign-in page
# shows a "For reviewers" card with the shared demo accounts and their
# password, and those four accounts can't have their password, email,
# two-factor sign-in changed, nor be deactivated or merged away. Allowed in
# production (the demo IS a production deployment).
# DEMO_MODE=on
# Shown on the card (optional, both or neither): when the demo data is reset —
# a 24-hour time and an IANA time zone; the card shows it in each reviewer's
# own time. Must match scripts/ops/stride-demo-reset.timer's OnCalendar.
# DEMO_RESET_TIME=04:00
# DEMO_RESET_TIME_ZONE=America/Toronto
# Shown on the card as a link (optional, https:// only): the reviewers' guide.
# DEMO_GUIDE_URL=https://github.com/julienjave/Stride-backend/blob/main/docs/demo-accounts.md

# === Email ===
# How emails (password resets, invitations) leave the app. Required — the
# app refuses to boot without it:
#   smtp   — through an SMTP server (the SMTP_* settings below). In local
#            development: Mailpit from docker-compose.yml, which catches
#            every email and shows it at http://localhost:8025 — links
#            clickable, nothing delivered to anyone.
#   log    — nothing is sent; each email is printed to the backend console,
#            links included. Needs no extra service. Local development
#            only: refused when NODE_ENV=production, since the links are
#            live secrets.
#   resend — real delivery through Resend's HTTP API (needs RESEND_API_KEY).
# The e2e tests replace the transport with an in-memory outbox, so this
# value doesn't affect the auth suite; the other suites need a valid one.
EMAIL_TRANSPORT=smtp
# Only read when EMAIL_TRANSPORT=smtp. Host and port are required; these
# are Mailpit's, from docker-compose.yml.
# 127.0.0.1, not "localhost": given a NAME, nodemailer first asks a DNS
# server on the network (which doesn't know "localhost") for an IPv4 and
# then an IPv6 address, and only after both fail asks the operating system.
# On Windows those two network lookups can each wait seconds for a timeout,
# so creating a user hung on "Creating…". An IP address skips the lookup.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Optional. "true" = TLS from the first byte (port 465); leave unset for
# Mailpit. SMTP_USER and SMTP_PASS go together, or neither (Mailpit needs
# no login).
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# Only required when EMAIL_TRANSPORT=resend.
RESEND_API_KEY=re_your_real_key_here
# The sender every email shows. With Mailpit any address works. With
# Resend: the shared onboarding@resend.dev sender only delivers to the
# address your Resend account was created with — use a sender on your own
# verified domain to email anyone else.
EMAIL_FROM=Stride <onboarding@resend.dev>

# === MFA secret encryption ===
# Must be EXACTLY 64 hex characters — validateEnv() checks both presence
# and this exact length.
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32 # Generate: openssl rand -hex 32

# === Connection pool sizing (optional — safe to leave commented out) ===
# Defaults already match what's used if these are absent entirely.
# DATABASE_POOL_MAX=10
# SESSION_POOL_MAX=5
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# === Error tracking ===
# Reports go to GlitchTip (docker-compose: `docker compose --profile errors
# up -d` in development; always on in docker-compose.prod.yml). LEAVE THE
# TWO DSNs EMPTY and nothing is reported — the default for development and
# tests. Each DSN comes from a GlitchTip project's settings ("Client Keys").
# In production write the host as `glitchtip:8000` (the compose network's
# name): the browser never contacts it, its reports go through POST
# /monitoring on this API.
#   SENTRY_DSN          the backend's project (e.g. "stride-api")
#   SENTRY_BROWSER_DSN  the frontend's project ("stride-web") — the only one
#                       POST /monitoring forwards for
# SENTRY_DSN=http://<key>@localhost:8000/1
# SENTRY_BROWSER_DSN=http://<key>@localhost:8000/2
# A label on every report; defaults to NODE_ENV.
# SENTRY_ENVIRONMENT=production
# Optional: the deployed version (a git commit), shown on each report.
# SENTRY_RELEASE=
# GlitchTip's own settings (read by docker compose, not by the app):
# GLITCHTIP_SECRET_KEY=generate-with-openssl-rand-hex-32
# GLITCHTIP_DB_PASSWORD=generate-with-openssl-rand-hex-24
# Optional: where its alert emails go (an SMTP URL); unset = its log.
# GLITCHTIP_EMAIL_URL=smtp://user:password@smtp.example.com:587
# GLITCHTIP_FROM_EMAIL=glitchtip@example.com