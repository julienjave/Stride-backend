# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stride

# RustFS — S3-compatible — matches docker-compose.yml's storage service
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# Session key
SESSION_SECRET=replace-with-a-long-random-string

# Frontend url
FRONTEND_URL=http://localhost:5173

# Number of reverse proxy hops in front of this app to trust for determining
# the real client IP (used by rate limiting, audit logging). Leave unset
# locally (defaults to 1, effectively harmless with no proxy present).
# Production behind Cloudflare + Caddy: set to 2.
# TRUST_PROXY_HOPS=2

# Emailing
RESEND_API_KEY=re_your_real_key_here
EMAIL_FROM=Stride <onboarding@resend.dev>

# MFA
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32