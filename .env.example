# === Database ===
# HOST/PORT are container SERVICE NAMES in production mode, not "localhost".
# app and db will be both containers on the same docker-compose network, 
# unlike local dev where the app runs directly on your host machine 
# and reaches the db container through its published port on localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres # Generate: openssl rand -hex 24
POSTGRES_DB=stride

# Restricted, non-superuser role the app's own runtime queries connect as
# (everything through drizzle.provider.ts) — separate from POSTGRES_USER
# above, which stays the superuser/owner used only for migrations and setup
# scripts. Must NOT be left as any placeholder — validateEnv() refuses to
# boot without a real value here. Run `npm run db:create-app-role` first to
# create/sync this role in Postgres, matching whatever you set below.
POSTGRES_APP_USER=stride_app
POSTGRES_APP_PASSWORD=replace-with-a-long-random-string # Generate: openssl rand -hex 24

# === Storage (RustFS) ===
# Same reasoning as POSTGRES_HOST above — the service name in production, not localhost.
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
RUSTFS_ACCESS_KEY=rustfsadmin # Generate: openssl rand -hex 16
RUSTFS_SECRET_KEY=rustfsadmin # Generate: openssl rand -hex 24

# === Sessions ===
# Must NOT be left as any placeholder — validateEnv() refuses to boot
# without a real value here.
SESSION_SECRET=replace-with-a-long-random-string # Generate: openssl rand -hex 32

# === CORS / Frontend ===
# FRONTEND_URL (singular) — used to build the actual link inside password
# reset emails. One canonical URL.
FRONTEND_URL=http://localhost:5173
# FRONTEND_URLS (plural) — comma-separated list of every origin allowed to
# make credentialed requests to this API. Add a second, comma-separated
# entry here later if you ever stand up a staging frontend too.
FRONTEND_URLS=http://localhost:5173

# === Proxy trust ===
# Number of reverse proxy hops in front of this app to trust for determining
# the real client IP (used by rate limiting, audit logging). Leave unset
# locally (defaults to 1, effectively harmless with no proxy present).
# Production behind Cloudflare + Caddy: set to 2.
# TRUST_PROXY_HOPS=2

# === Node environment ===
# When in production mode
# Flips pino to raw JSON logging, and enables secure/sameSite=none session
# cookies — both REQUIRE this to be exactly "production", not left unset.
# NODE_ENV=production

# === Email (Resend) ===
RESEND_API_KEY=re_your_real_key_here
EMAIL_FROM=Stride <onboarding@resend.dev>

# === MFA secret encryption ===
# Must be EXACTLY 64 hex characters — validateEnv() checks both presence
# and this exact length.
MFA_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32 # Generate: openssl rand -hex 32

# === Connection pool sizing (optional — safe to leave commented out) ===
# Defaults already match what's used if these are absent entirely.
# DATABASE_POOL_MAX=10
# SESSION_POOL_MAX=5
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000